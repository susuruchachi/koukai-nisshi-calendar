<?xml version="1.0" encoding="utf-8"?>
<!-- 航海日誌の Android アプリ：ウェブ版を WebView で表示し、ホーム画面のウィジェット（カレンダー・できた事日記）を持つ -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 新しい APK を、アプリの中から上書きインストールする（自動更新。初めてのときだけ「この提供元のアプリを許可」を聞かれる） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 🔔 タスクのアラーム：通知（Android 13 から許可が要る）・時刻どおりに鳴らす・再起動のあとに入れ直す -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- ★【1.7.0】 すするアプリ（ランチャー）が入っているかを見る（LauncherInstaller） -->
    <queries>
        <package android:name="io.github.susuruchachi.susurulauncher" />
        <!-- ★【1.9.0】 上のバーで、ほかの2つのアプリが入っているかを見る（LauncherBar） -->
        <package android:name="io.github.susuruchachi.susuruanki" />
        <package android:name="io.github.susuruchachi.koukainisshi" />
        <package android:name="io.github.susuruchachi.kashikari" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/appName"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/appName"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- ブラウザで Google にログインしたあと「アプリに戻る」で戻ってくる（app-login.html → koukainisshi://auth） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="koukainisshi" android:host="auth" />
            </intent-filter>
        </activity>

        <!-- ホーム画面のウィジェット：今月のカレンダーと今日の予定 -->
        <receiver android:name=".CalendarWidget" android:exported="false" android:label="@string/calWidgetName">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_calendar_info" />
        </receiver>

        <!-- ホーム画面のウィジェット：今日のできた事（3つ）と、すするanki でできた単語の数 -->
        <receiver android:name=".DiaryWidget" android:exported="false" android:label="@string/diaryWidgetName">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_diary_info" />
        </receiver>
        <!-- ホーム画面のウィジェット：★を付けた大事な予定と、あと何日 -->
        <receiver android:name=".StarWidget" android:exported="false" android:label="@string/starWidgetName">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_star_info" />
        </receiver>
        <!-- 🔔 タスクのアラーム（鳴らす・完了にする・10分後）と、再起動のあとに入れ直す -->
        <receiver android:name=".AlarmReceiver" android:exported="false" />
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- アプリの自動更新（入れた結果・閉じて1分後に起こす） -->
        <receiver android:name=".InstallResultReceiver" android:exported="false" />
        <!-- ★【1.7.0】 すするアプリを入れた結果（LauncherInstaller） -->
        <receiver android:name=".LauncherInstaller$Result" android:exported="false" />
    </application>
</manifest>
